<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User All Posts</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h2 style="color: white;"><a href="/">@<%= username %></a> All Posts</h2>
    &nbsp;&nbsp;&nbsp;&nbsp;
    <% for(let post of allPost){ %>

        <div class="post">
            <p>
                <%= post.content %>
            </p>
            <a href="http://localhost:8080/posts/<%= post.id %>">Detail</a>
            &nbsp;&nbsp;&nbsp;&nbsp;
            <a href="http://localhost:8080/posts">Posts</a>
        </div>

        <% } %>
</body>

</html>