<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show individual post</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h2 id="logo">SHow INDividual POst</h2>

    <p class="id">Post Id: <%= post.id %> </p>
    <div class="post">
        <h3 class="user">@<%= post.username %> </h3>
        <p>
            <%= post.content %>
        </p>
    </div>
    <a href="http://localhost:8080/posts" class="id">Posts</a>
</body>

</html>