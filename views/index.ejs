<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1 id="logo">Quora Posts</h1>
    <form action="/search" method="get">
        <input type="text" name="username" placeholder="Search">
        <button type="submit">Search</button>
    </form>
    <% for(let post of posts){ %>

        <div class="post">
            <h3 class="user">@<%= post.username %></h3>
            <p> <%= post.content %></p>
            <a href="http://localhost:8080/posts/<%= post.id %>">Detail</a>
            &nbsp;&nbsp;&nbsp;&nbsp;
            <a href="http://localhost:8080/posts/<%= post.id %>/edit">Edit</a>
             &nbsp;&nbsp;&nbsp;&nbsp;
            <form action="/posts/<%= post.id %>/likes" method="post" style="display: inline;">
                <button>❤️<%= post.likes %></button>
            </form>
             &nbsp;&nbsp;&nbsp;&nbsp;
            <form method="post" action="/posts/<%= post.id %>?_method=DELETE" style="display: inline;">
                <button>Delete</button>
            </form>

        </div>

    <% } %>




    <a href="http://localhost:8080/posts/new">Create new Post</a>


    <script src="likes.js"></script>
</body>
</html>